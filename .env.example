VITE_SUPABASE_URL=your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here
VITE_API_URL=http://localhost:4000

# Secret Edge Function (supabase/functions/generate-application dan green-career-assessment). BUKAN variabel Vite: jangan
# diberi awalan VITE_. Pasang lewat `supabase secrets set NAMA=nilai` atau dashboard Supabase, bukan di berkas ini.
# Urutan bawaan paket Free dan Pro: Numes, lalu Gemini, lalu model gratis OpenRouter, dan Anthropic (Claude) paling akhir.
# Kunci platform Numes (https://numes.ai), satu sampai tiga. Kunci berikutnya dipakai bila yang pertama kena 401/402/403/429,
# kuota habis, galat 5xx, atau batas waktu; pemakaian bergilir antarpanggilan. Paling berguna bila berasal dari akun Numes berbeda.
# NUMES_API_KEY=
# Kunci Numes kedua (opsional).
# NUMES_API_KEY_2=
# Kunci Numes ketiga (opsional).
# NUMES_API_KEY_3=
# Cara lain: daftar kunci Numes dipisah koma (digabung dengan tiga secret di atas, duplikat dibuang, paling banyak 3 kunci).
# NUMES_API_KEYS=
# Kunci Gemini (Google AI Studio), setelah Numes.
# GEMINI_API_KEY=
# Kunci OpenRouter untuk model gratis.
# OPENROUTER_API_KEY=
# Kunci Anthropic (Claude), selalu paling akhir sesudah penyedia lain.
# ANTHROPIC_API_KEY=
# Rantai model per paket, dipisah koma: "numes:<author/slug>", "gemini:<model>", "anthropic:<model>", atau slug OpenRouter.
# Kosong = bawaan di supabase/functions/_shared/providers.ts. Entri anthropic: selalu dijalankan paling akhir.
# FREE_MODELS=
# PRO_MODELS=
